{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@20.x"
    }
  },
  "redirects": [
    {
      "source": "/products/test",
      "destination": "/en/products/catalog-optimized",
      "permanent": true
    },
    {
      "source": "/products/catalog",
      "destination": "/en/products/catalog-optimized",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
