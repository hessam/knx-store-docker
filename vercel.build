#!/bin/bash

# Vercel Build Script for KNX Store
# This script runs during Vercel's build process

echo "🚀 Starting Vercel build for KNX Store..."

# Set environment variables based on Vercel environment
if [ "$VERCEL_ENV" = "production" ]; then
  echo "📦 Building for production..."
  export NODE_ENV=production
  export SITE_URL=$VERCEL_URL
elif [ "$VERCEL_ENV" = "preview" ]; then
  echo "🔍 Building for preview..."
  export NODE_ENV=preview
  export SITE_URL=$VERCEL_URL
else
  echo "🧪 Building for development..."
  export NODE_ENV=development
  export SITE_URL=$VERCEL_URL
fi

# Ensure ALLOW_BUILD_WITHOUT_API is set for builds
export ALLOW_BUILD_WITHOUT_API=true

# Install dependencies (include dev dependencies for build process)
echo "📥 Installing dependencies..."
npm ci

# Validate environment variables
echo "🔍 Validating environment variables..."
echo "WOOCOMMERCE_API_URL: ${WOOCOMMERCE_API_URL:0:30}..."
echo "WOOCOMMERCE_CONSUMER_KEY: ${WOOCOMMERCE_CONSUMER_KEY:0:10}..."
echo "WOOCOMMERCE_CONSUMER_SECRET: ${WOOCOMMERCE_CONSUMER_SECRET:0:10}..."
echo "ALLOW_BUILD_WITHOUT_API: $ALLOW_BUILD_WITHOUT_API"

# Build the application
echo "🔨 Building application..."
npm run build

# Check if build was successful
if [ $? -eq 0 ]; then
  echo "✅ Build completed successfully"
else
  echo "❌ Build failed"
  exit 1
fi

# Run post-build optimizations
echo "⚡ Running post-build optimizations..."

# Check build output
echo "� Build summary:"
echo "  - Environment: $VERCEL_ENV"
echo "  - Node Version: $(node --version)"
echo "  - NPM Version: $(npm --version)"
echo "  - Build Directory: $(pwd)/dist"
ls -la dist/ | head -5

echo "✅ Vercel build completed successfully!"
echo "  - Site URL: $SITE_URL"
echo "  - Build directory: dist/"
ls -la dist/ | head -5

echo "✅ Vercel build completed successfully!" 