---
// Checkout page redirect - static version
import Layout from '../layouts/Layout.astro';
---

<Layout title="Checkout - KNX Store">
  <head>
    <meta http-equiv="refresh" content="0; url=/en/checkout" />
    <link rel="canonical" href="/en/checkout" />
  </head>
  
  <main>
    <div style="text-align: center; padding: 2rem;">
      <h1>Checkout</h1>
      <p>Redirecting to checkout page...</p>
      <p>If you are not redirected automatically, <a href="/en/checkout">click here</a>.</p>
    </div>
  </main>
  
  <script>
    if (typeof window !== 'undefined') {
      window.location.href = '/en/checkout';
    }
  </script>
</Layout>
