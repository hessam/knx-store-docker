---
import Layout from '../../../layouts/Layout.astro';
import { getWooCommerceSync } from '../../../lib/api/woocommerce-sync';
import { loadTranslations } from '../../../lib/i18n';
import type { WooCommerceProduct } from '../../../lib/api/woocommerce-sync';

// Helper functions
function isValidLanguage(lang: string): boolean {
  const validLanguages = ['en', 'de', 'ar'];
  return validLanguages.includes(lang);
}

// Use loadTranslations directly from import

export const prerender = true;

export async function getStaticPaths() {
  console.log('[Product Pages] getStaticPaths called for dynamic route');
  
  const languages = ['en', 'de', 'ar'];
  
  // Always provide fallback paths to ensure build never fails
  const fallbackProduct = {
    id: 1,
    name: "KNX Smart Switch - Fallback",
    slug: "knx-smart-switch-fallback",
    permalink: "https://mohtavaly.com/product/knx-smart-switch-fallback/",
    date_created: new Date().toISOString(),
    date_modified: new Date().toISOString(),
    type: "simple",
    status: "publish",
    featured: false,
    catalog_visibility: "visible",
    description: "Fallback product - WooCommerce API temporarily unavailable",
    short_description: "Fallback product",
    sku: "FALLBACK-001",
    price: "99.99",
    regular_price: "99.99",
    sale_price: "",
    date_on_sale_from: null,
    date_on_sale_to: null,
    on_sale: false,
    purchasable: true,
    total_sales: 0,
    virtual: false,
    downloadable: false,
    downloads: [],
    download_limit: -1,
    download_expiry: -1,
    tax_status: "taxable",
    tax_class: "",
    manage_stock: false,
    stock_quantity: null,
    stock_status: "instock",
    backorders: "no",
    backorders_allowed: false,
    backordered: false,
    sold_individually: false,
    weight: "0.5",
    dimensions: { length: "10", width: "5", height: "2" },
    shipping_required: true,
    shipping_taxable: true,
    shipping_class: "",
    shipping_class_id: 0,
    reviews_allowed: true,
    average_rating: "0.00",
    rating_count: 0,
    images: [
      {
        id: 1,
        date_created: new Date().toISOString(),
        date_modified: new Date().toISOString(),
        src: "https://picsum.photos/300/300?random=1",
        name: "Fallback Product",
        alt: "Fallback Product Image"
      }
    ],
    categories: [{ id: 1, name: "KNX Products", slug: "knx-products" }],
    tags: [],
    attributes: [],
    variations: [],
    menu_order: 0,
    meta_data: [],
    _links: { self: [{}], collection: [{}] }
  };

  // Function to generate fallback paths
  const generateFallbackPaths = () => {
    const paths = [];
    for (const lang of languages) {
      paths.push({
        params: {
          lang: lang,
          slug: fallbackProduct.slug
        },
        props: {
          product: fallbackProduct,
          lang: lang
        }
      });
    }
    console.log(`[Product Pages] Using fallback, generated ${paths.length} paths`);
    return paths;
  };

  try {
    // Try to use the real WooCommerce sync to fetch products
    const { getWooCommerceSync } = await import('../../../lib/api/woocommerce-sync');
    const wooCommerceSync = getWooCommerceSync();
    const products = await wooCommerceSync.fetchProducts();
    
    console.log(`[Product Pages] Fetched ${products.length} products from WooCommerce`);
    
    // If we have real products, use them
    if (products && products.length > 0) {
      const paths = [];
      for (const product of products) {
        // Skip products with invalid slugs
        if (!product.slug || product.slug.trim() === '') {
          console.warn(`[Product Pages] Skipping product with invalid slug:`, product.id, product.name);
          continue;
        }
        
        // Validate slug to ensure it's safe for URL routing
        const slug = product.slug.trim();
        
        // Skip URL-encoded slugs that contain non-ASCII characters
        if (slug.includes('%') || /[^\w\-]/.test(slug)) {
          console.warn(`[Product Pages] Skipping product with complex slug:`, product.id, slug);
          continue;
        }
        
        for (const lang of languages) {
          paths.push({
            params: {
              lang: lang,
              slug: slug
            },
            props: {
              product: product,
              lang: lang
            }
          });
        }
      }
      
      // If no valid products after filtering, use fallback
      if (paths.length === 0) {
        console.log('[Product Pages] No valid products after filtering, using fallback');
        return generateFallbackPaths();
      }
      
      console.log(`[Product Pages] Generated ${paths.length} static paths`);
      return paths;
    } else {
      // No products returned, use fallback
      console.log('[Product Pages] No products returned from API, using fallback');
      return generateFallbackPaths();
    }
    
  } catch (error) {
    console.error('[Product Pages] Error fetching products, using fallback:', error);
    return generateFallbackPaths();
  }
}

// Get product from props
const { product, lang } = Astro.props as { product: WooCommerceProduct; lang: string };

// Validate language
if (!lang || !isValidLanguage(lang)) {
  return Astro.redirect('/en/products/catalog');
}

// Load translations
const t = loadTranslations(lang);

// Get URL for metadata
const url = new URL(Astro.request.url);

// SEO metadata
const title = `${product.name} - KNX Store`;
const description = product.short_description || product.description?.substring(0, 160) + '...' || `${product.name} - High-quality KNX product`;
const imageUrl = product.images?.[0]?.src || `${url.origin}/images/default-product.jpg`;

// Structured data for product
const productStructuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.name,
  "description": product.description || product.short_description,
  "image": product.images?.map((img: any) => img.src) || [imageUrl],
  "sku": product.sku || `KNX-${product.id}`,
  "mpn": product.sku,
  "brand": "KNX",
  "category": product.categories?.[0]?.name || "KNX Products",
  "offers": {
    "@type": "Offer",
    "price": product.price,
    "priceCurrency": "USD",
    "availability": product.stock_status === 'instock'
      ? "https://schema.org/InStock"
      : "https://schema.org/OutOfStock",
    "url": url.toString()
  },
  "aggregateRating": product.rating_count > 0 ? {
    "@type": "AggregateRating",
    "ratingValue": product.average_rating,
    "reviewCount": product.rating_count,
    "bestRating": "5",
    "worstRating": "1"
  } : undefined
};

// Breadcrumb structured data
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t.home, "item": `${url.origin}/${lang}` },
    { "@type": "ListItem", "position": 2, "name": t.products, "item": `${url.origin}/${lang}/products/catalog` },
    { "@type": "ListItem", "position": 3, "name": product.categories?.[0]?.name || t.products, "item": `${url.origin}/${lang}/products/catalog?category=${product.categories?.[0]?.slug || ''}` },
    { "@type": "ListItem", "position": 4, "name": product.name, "item": url.toString() }
  ]
};

// Combined structured data
const structuredData = [productStructuredData, breadcrumbStructuredData];
---

<Layout
  title={title}
  description={description}>
  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} slot="head"></script>

  <!-- Open Graph Meta Tags -->
  <meta property="og:title" content={title} slot="head">
  <meta property="og:description" content={description} slot="head">
  <meta property="og:image" content={imageUrl} slot="head">
  <meta property="og:url" content={url.toString()} slot="head">
  <meta property="og:type" content="product" slot="head">

  <!-- Product-specific meta tags -->
  <meta property="product:price:amount" content={product.price} slot="head">
  <meta property="product:price:currency" content="USD" slot="head">
  <meta property="product:availability" content={product.stock_status === 'instock' ? 'in stock' : 'out of stock'} slot="head">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" slot="head">
  <meta name="twitter:title" content={title} slot="head">
  <meta name="twitter:description" content={description} slot="head">
  <meta name="twitter:image" content={imageUrl} slot="head">

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb Navigation -->
    <nav class="mb-8" aria-label="Breadcrumb">
      <ol class="flex items-center space-x-2 text-sm">
        <li>
          <a href={`/${lang}`} class="text-blue-600 hover:text-blue-800 transition-colors">
            {t.home}
          </a>
        </li>
        <li class="text-gray-500">/</li>
        <li>
          <a href={`/${lang}/products/catalog`} class="text-blue-600 hover:text-blue-800 transition-colors">
            {t.products}
          </a>
        </li>
        {product.categories?.[0] && (
          <>
            <li class="text-gray-500">/</li>
            <li>
              <a
                href={`/${lang}/products/catalog?category=${product.categories[0].slug}`}
                class="text-blue-600 hover:text-blue-800 transition-colors"
              >
                {product.categories[0].name}
              </a>
            </li>
          </>
        )}
        <li class="text-gray-500">/</li>
        <li class="text-gray-900 font-medium">{product.name}</li>
      </ol>
    </nav>

    <!-- Product Content -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Product Images -->
      <div class="space-y-4">
        <!-- Main Image -->
        <div class="aspect-square bg-gray-100 rounded-lg overflow-hidden">
          {product.images?.[0] ? (
            <img
              src={product.images[0].src}
              alt={product.images[0].alt || product.name}
              class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-300"
              loading="eager"
              width="600"
              height="600"
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center bg-gray-200">
              <span class="text-gray-500 text-lg">No Image</span>
            </div>
          )}
        </div>

        <!-- Thumbnail Gallery -->
        {product.images && product.images.length > 1 && (
          <div class="grid grid-cols-4 gap-2">
            {product.images.slice(0, 4).map((image: any, index: number) => (
              <div class="aspect-square bg-gray-100 rounded-lg overflow-hidden cursor-pointer hover:opacity-75 transition-opacity">
                <img
                  src={image.src}
                  alt={image.alt || `${product.name} - Image ${index + 1}`}
                  class="w-full h-full object-cover object-center"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Product Information -->
      <div class="space-y-6">
        <!-- Product Title & Rating -->
        <div>
          <h1 class="text-3xl font-bold text-gray-900 mb-2">{product.name}</h1>

          {product.rating_count > 0 && (
            <div class="flex items-center space-x-2 mb-4">
              <div class="flex text-yellow-400">
                {'★'.repeat(Math.floor(parseFloat(product.average_rating || '0')))}
                {'☆'.repeat(5 - Math.floor(parseFloat(product.average_rating || '0')))}
              </div>
              <span class="text-sm text-gray-600">
                {product.average_rating} ({product.rating_count} {t.reviews || 'reviews'})
              </span>
            </div>
          )}

          <!-- SKU and Categories -->
          <div class="text-sm text-gray-600 space-y-1">
            {product.sku && <div><span>SKU: {product.sku}</span></div>}
            {product.categories && product.categories.length > 0 && (
              <div class="flex items-center space-x-1">
                <span>{t.categories || 'Categories'}:</span>
                {product.categories.map((cat: any, index: number) => (
                  <span>
                    <a href={`/${lang}/products/catalog?category=${cat.slug}`} class="text-blue-600 hover:text-blue-800">
                      {cat.name}
                    </a>
                    {index < product.categories.length - 1 && ', '}
                  </span>
                ))}
              </div>
            )}
          </div>
        </div>

        <!-- Price -->
        <div class="text-3xl font-bold">
          {product.on_sale ? (
            <div class="space-x-3">
              <span class="text-3xl font-bold text-red-600">${product.sale_price}</span>
              <span class="text-xl text-gray-500 line-through">${product.regular_price}</span>
            </div>
          ) : (
            <div>
              <span class="text-3xl font-bold text-gray-900">${product.price}</span>
            </div>
          )}
        </div>

        <!-- Stock Status -->
        <div class="flex items-center space-x-3">
          {product.stock_status === 'instock' ? (
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
              ✓ {t.inStock || 'In Stock'}
            </span>
          ) : (
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
              ✗ {t.outOfStock || 'Out of Stock'}
            </span>
          )}
        </div>

        <!-- Short Description -->
        {product.short_description && (
          <div>
            <p class="text-lg text-gray-700" set:html={product.short_description}></p>
          </div>
        )}

        <!-- Action Buttons -->
        <div class="space-y-4">
          {product.stock_status === 'instock' ? (
            <button
              class="w-full bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition-colors font-semibold"
              data-track-event="add_to_cart"
              data-track-category="Product"
              data-track-label={product.name}
              data-product-id={product.id}
            >
              {t.addToCart || 'Add to Cart'}
            </button>
          ) : (
            <button
              disabled
              class="w-full bg-gray-300 text-gray-500 px-8 py-3 rounded-lg cursor-not-allowed font-semibold"
              data-track-event="button_click"
              data-track-category="Product"
              data-track-label={product.name}
            >
              {t.outOfStock || 'Out of Stock'}
            </button>
          )}

          <button
            class="w-full border border-gray-300 text-gray-700 px-8 py-3 rounded-lg hover:bg-gray-50 transition-colors font-semibold"
            data-track-event="contact_inquiry"
            data-track-category="Product"
            data-track-label={product.name}
          >
            Contact for Quote
          </button>
        </div>

        <!-- Tags -->
        {product.tags && product.tags.length > 0 && (
          <div>
            <h3 class="text-sm font-medium text-gray-900 mb-2">Tags</h3>
            <div class="flex flex-wrap gap-2">
              {product.tags.map((tag: any) => (
                <a
                  href={`/${lang}/products/catalog?tag=${tag.slug}`}
                  class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800 hover:bg-gray-200 transition-colors"
                >
                  {tag.name}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Product Details Tabs -->
    <div class="mt-16">
      <div class="border-b border-gray-200">
        <nav class="-mb-px flex space-x-8" aria-label="Tabs">
          <button class="tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-2 px-1 border-b-2 font-medium text-sm active" data-tab="description">
            {t.description || 'Description'}
          </button>
          <button class="tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-2 px-1 border-b-2 font-medium text-sm" data-tab="specifications">
            {t.specifications || 'Specifications'}
          </button>
          <button class="tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-2 px-1 border-b-2 font-medium text-sm" data-tab="reviews">
            {t.reviews || 'Reviews'} ({product.rating_count || 0})
          </button>
        </nav>
      </div>

      <!-- Tab Content -->
      <div class="mt-8">
        <!-- Description Tab -->
        <div id="tab-description" class="tab-content">
          {product.description ? (
            <div class="prose max-w-none">
              <div set:html={product.description}></div>
            </div>
          ) : (
            <p class="text-gray-500">No description available</p>
          )}
        </div>

        <!-- Specifications Tab -->
        <div id="tab-specifications" class="tab-content hidden">
          {product.attributes && product.attributes.length > 0 ? (
            <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
              {product.attributes.map((attr: any) => (
                <div class="border-b border-gray-200 pb-2">
                  <dt class="text-sm font-medium text-gray-900">{attr.name}</dt>
                  <dd class="text-sm text-gray-700">{attr.options.join(', ')}</dd>
                </div>
              ))}
            </dl>
          ) : (
            <div class="space-y-4">
              <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
                <div class="border-b border-gray-200 pb-2">
                  <dt class="text-sm font-medium text-gray-900">{t.weight || 'Weight'}</dt>
                  <dd class="text-sm text-gray-900">{product.weight || 'Not specified'}</dd>
                </div>
                {product.dimensions && (
                  <div class="border-b border-gray-200 pb-2">
                    <dt class="text-sm font-medium text-gray-900">{t.dimensions || 'Dimensions'}</dt>
                    <dd class="text-sm text-gray-900">
                      {product.dimensions.length}×{product.dimensions.width}×{product.dimensions.height} cm
                    </dd>
                  </div>
                )}
              </dl>
            </div>
          )}
        </div>

        <!-- Reviews Tab -->
        <div id="tab-reviews" class="tab-content hidden">
          {product.rating_count > 0 ? (
            <div class="space-y-6">
              <div class="text-center py-8">
                <div class="text-4xl font-bold text-gray-900 mb-2">{product.average_rating}</div>
                <div class="flex justify-center text-yellow-400 text-xl mb-2">
                  {'★'.repeat(Math.floor(parseFloat(product.average_rating || '0')))}
                  {'☆'.repeat(5 - Math.floor(parseFloat(product.average_rating || '0')))}
                </div>
                <p class="text-gray-600">Based on {product.rating_count} {t.reviews || 'reviews'}</p>
              </div>
            </div>
          ) : (
            <div class="text-center py-8">
              <p class="text-gray-500">No reviews yet</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- JavaScript for tab functionality -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      const tabButtons = document.querySelectorAll('.tab-button');
      const tabContents = document.querySelectorAll('.tab-content');

      tabButtons.forEach(button => {
        button.addEventListener('click', function() {
          const tabId = this.dataset.tab;

          // Remove active class from all buttons
          tabButtons.forEach(btn => {
            btn.classList.remove('border-blue-500', 'text-blue-600');
            btn.classList.add('border-transparent', 'text-gray-500');
          });

          // Add active class to clicked button
          this.classList.remove('border-transparent', 'text-gray-500');
          this.classList.add('border-blue-500', 'text-blue-600');

          // Hide all tab contents
          tabContents.forEach(content => {
            content.classList.add('hidden');
          });

          // Show selected tab content
          const selectedTab = document.getElementById(`tab-${tabId}`);
          if (selectedTab) {
            selectedTab.classList.remove('hidden');
          }
        });
      });
    });
  </script>
</Layout>