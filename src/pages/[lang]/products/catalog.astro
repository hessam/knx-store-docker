---
/**
 * Advanced Product Catalog Component
 * High-performance, SEO-optimized product catalog with search and filters
 */
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { loadTranslations, isValidLanguage } from '../../../lib/i18n';

// Enable static generation for Core Web Vitals optimization
export const prerender = true;

// Generate static paths for all supported languages
export const getStaticPaths: GetStaticPaths = async () => {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'ar' } }
  ];
};

const { lang } = Astro.params;

// Validate language parameter
if (!lang || !isValidLanguage(lang as string)) {
  return Astro.redirect('/en/products/catalog');
}

// Load translations for the current language
const t = loadTranslations(lang as string);

// Extract search parameters from URL
const url = new URL(Astro.request.url);
const searchQuery = url.searchParams.get('q') || '';
const category = url.searchParams.get('category') || '';
const sortBy = url.searchParams.get('sort') || 'name';
const order = url.searchParams.get('order') || 'asc';
const page = parseInt(url.searchParams.get('page') || '1');
const perPage = Math.min(parseInt(url.searchParams.get('per_page') || '24'), 48); // Max 48 per page

// SEO-optimized title and meta
const baseTitle = searchQuery 
  ? `${t.searchResults} "${searchQuery}" - KNX Store`
  : category 
    ? `${category} ${t.products} - KNX Store`
    : `${t.productCatalog} - KNX Store`;

const metaDescription = searchQuery
  ? `${t.searchResults} for "${searchQuery}". ${t.highQualityKnxProducts} with fast shipping and expert support.`
  : `${t.browseOurComprehensive} KNX ${t.productCatalog}. ${t.smartBuildingAutomation} products for residential and commercial projects.`;

// Structured data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": baseTitle,
  "description": metaDescription,
  "url": url.toString(),
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${url.origin}/${lang}` },
      { "@type": "ListItem", "position": 2, "name": t.products, "item": `${url.origin}/${lang}/products` },
      { "@type": "ListItem", "position": 3, "name": t.catalog, "item": url.toString() }
    ]
  },
  "mainEntity": {
    "@type": "ItemList",
    "name": t.productCatalog,
    "description": metaDescription
  }
};
---

<Layout 
  title={baseTitle}
  description={metaDescription}
>
  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} slot="head"></script>
  <!-- Preload critical resources for performance -->
  <link rel="preload" href="/api/products/search" as="fetch" crossorigin="anonymous" slot="head">
  <link rel="preconnect" href="https://picsum.photos" slot="head">
  
  <!-- Open Graph meta tags for social sharing -->
  <meta property="og:title" content={baseTitle} slot="head">
  <meta property="og:description" content={metaDescription} slot="head">
  <meta property="og:type" content="website" slot="head">
  <meta property="og:url" content={url.toString()} slot="head">
  
  <!-- Twitter Card meta tags -->
  <meta name="twitter:card" content="summary_large_image" slot="head">
  <meta name="twitter:title" content={baseTitle} slot="head">
  <meta name="twitter:description" content={metaDescription} slot="head">

  <main class="min-h-screen bg-gray-50">
    <!-- Hero Section with Search -->
    <section class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-12">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-bold mb-4">
            {searchQuery ? t.searchResults : t.productCatalog}
          </h1>
          <p class="text-xl mb-8 opacity-90">
            {searchQuery 
              ? `${t.foundResults} "${searchQuery}"`
              : t.discoverHighQuality
            }
          </p>
          
          <!-- Advanced Search Form -->
          <form 
            id="search-form" 
            class="bg-white rounded-lg p-6 text-gray-900 shadow-2xl"
            data-track-event="search_form"
            data-track-category="product_search"
          >
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
              <!-- Search Query -->
              <div class="md:col-span-2">
                <label for="search-input" class="sr-only">{t.searchProducts}</label>
                <input
                  id="search-input"
                  type="text"
                  name="q"
                  value={searchQuery}
                  placeholder={t.searchProducts}
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  autocomplete="off"
                  data-track-event="search_input"
                  data-track-label="product_search"
                >
              </div>
              
              <!-- Category Filter -->
              <div>
                <select 
                  name="category"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                  data-track-event="category_filter"
                >
                  <option value="">{t.allCategories}</option>
                  <option value="switches" selected={category === 'switches'}>{t.switches}</option>
                  <option value="sensors" selected={category === 'sensors'}>{t.sensors}</option>
                  <option value="actuators" selected={category === 'actuators'}>{t.actuators}</option>
                  <option value="interfaces" selected={category === 'interfaces'}>{t.interfaces}</option>
                  <option value="controllers" selected={category === 'controllers'}>{t.controllers}</option>
                </select>
              </div>
              
              <!-- Sort Options -->
              <div>
                <select 
                  name="sort"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                  data-track-event="sort_filter"
                >
                  <option value="name" selected={sortBy === 'name'}>{t.sortByName}</option>
                  <option value="price" selected={sortBy === 'price'}>{t.sortByPrice}</option>
                  <option value="date" selected={sortBy === 'date'}>{t.sortByDate}</option>
                  <option value="popularity" selected={sortBy === 'popularity'}>{t.sortByPopularity}</option>
                  <option value="rating" selected={sortBy === 'rating'}>{t.sortByRating}</option>
                </select>
              </div>
            </div>
            
            <!-- Advanced Filters -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
              <!-- Price Range -->
              <div>
                <label class="block text-sm font-medium mb-2">{t.priceRange}</label>
                <div class="flex gap-2">
                  <input
                    type="number"
                    name="min_price"
                    placeholder={t.minPrice}
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500"
                    min="0"
                    step="0.01"
                  >
                  <input
                    type="number"
                    name="max_price"
                    placeholder={t.maxPrice}
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500"
                    min="0"
                    step="0.01"
                  >
                </div>
              </div>
              
              <!-- Items Per Page -->
              <div>
                <label class="block text-sm font-medium mb-2">{t.itemsPerPage}</label>
                <select 
                  name="per_page"
                  class="w-full px-3 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500"
                >
                  <option value="12" selected={perPage === 12}>12</option>
                  <option value="24" selected={perPage === 24}>24</option>
                  <option value="36" selected={perPage === 36}>36</option>
                  <option value="48" selected={perPage === 48}>48</option>
                </select>
              </div>
              
              <!-- Featured Only -->
              <div>
                <label class="block text-sm font-medium mb-2">{t.featuredOnly}</label>
                <label class="flex items-center">
                  <input
                    type="checkbox"
                    name="featured"
                    value="true"
                    class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                  >
                  <span class="ml-2">{t.showFeaturedOnly}</span>
                </label>
              </div>
            </div>
            
            <!-- Search Button -->
            <button
              type="submit"
              class="w-full md:w-auto bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition-colors duration-200 font-semibold"
              data-track-event="search_submit"
              data-track-category="product_search"
            >
              🔍 {t.searchProducts}
            </button>
          </form>
        </div>
      </div>
    </section>

    <!-- Results Section -->
    <section class="container mx-auto px-4 py-8">
      <!-- Loading State -->
      <div id="loading-state" class="text-center py-12">
        <div class="inline-flex items-center px-4 py-2 font-semibold text-blue-600">
          <svg class="animate-spin -ml-1 mr-3 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          {t.searchingProducts}...
        </div>
      </div>

      <!-- Results Header -->
      <div id="results-header" class="hidden mb-6">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
          <div>
            <h2 id="results-title" class="text-2xl font-bold text-gray-900"></h2>
            <p id="results-summary" class="text-gray-600"></p>
          </div>
          <div id="results-meta" class="text-sm text-gray-500"></div>
        </div>
      </div>

      <!-- Active Filters -->
      <div id="active-filters" class="hidden mb-6">
        <h3 class="text-sm font-medium text-gray-700 mb-2">{t.activeFilters}:</h3>
        <div id="filter-tags" class="flex flex-wrap gap-2"></div>
      </div>

      <!-- Error State -->
      <div id="error-state" class="hidden bg-red-50 border border-red-200 rounded-lg p-6 text-center">
        <div class="text-red-600">
          <svg class="mx-auto h-12 w-12 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.5 0L4.268 15.5c-.77.833.192 2.5 1.732 2.5z" />
          </svg>
          <h3 class="text-lg font-medium mb-2">{t.searchError}</h3>
          <p id="error-message"></p>
        </div>
      </div>

      <!-- No Results State -->
      <div id="no-results-state" class="hidden text-center py-12">
        <div class="text-gray-500">
          <svg class="mx-auto h-16 w-16 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0118 12a8 8 0 01-8 8 8 8 0 01-8-8 8 8 0 018-8c.343 0 .682.022 1.016.066" />
          </svg>
          <h3 class="text-xl font-medium mb-2">{t.noProductsFound}</h3>
          <p class="text-gray-600 mb-4">{t.tryDifferentSearch}</p>
          <button id="clear-filters-btn" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700">
            {t.clearFilters}
          </button>
        </div>
      </div>

      <!-- Products Grid -->
      <div id="products-grid" class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"></div>

      <!-- Pagination -->
      <div id="pagination" class="hidden mt-8 flex justify-center">
        <nav class="flex items-center space-x-2" aria-label="Pagination">
          <button id="prev-page" class="px-3 py-2 text-gray-500 hover:text-gray-700 disabled:opacity-50" disabled>
            ← {t.previous}
          </button>
          <div id="page-numbers" class="flex space-x-1"></div>
          <button id="next-page" class="px-3 py-2 text-gray-500 hover:text-gray-700 disabled:opacity-50" disabled>
            {t.next} →
          </button>
        </nav>
      </div>

      <!-- Load More Button for Mobile -->
      <div id="load-more" class="hidden mt-8 text-center md:hidden">
        <button id="load-more-btn" class="bg-gray-600 text-white px-8 py-3 rounded-lg hover:bg-gray-700">
          {t.loadMore}
        </button>
      </div>
    </section>
  </main>

  <!-- High-Performance Search Script -->
  <script define:vars={{ lang, t }}>
    class ProductCatalog {
      constructor() {
        this.currentResults = null;
        this.currentPage = 1;
        this.isLoading = false;
        this.init();
      }

      init() {
        this.bindEvents();
        this.performInitialSearch();
      }

      bindEvents() {
        // Search form submission
        const searchForm = document.getElementById('search-form');
        searchForm?.addEventListener('submit', (e) => {
          e.preventDefault();
          this.handleSearch();
        });

        // Real-time search on input (debounced)
        const searchInput = document.getElementById('search-input');
        let searchTimeout;
        searchInput?.addEventListener('input', (e) => {
          clearTimeout(searchTimeout);
          searchTimeout = setTimeout(() => {
            this.handleSearch();
          }, 500); // 500ms debounce
        });

        // Filter changes
        document.querySelectorAll('select, input[type="checkbox"]').forEach(element => {
          element.addEventListener('change', () => {
            this.handleSearch();
          });
        });

        // Clear filters
        document.getElementById('clear-filters-btn')?.addEventListener('click', () => {
          this.clearFilters();
        });

        // Pagination
        document.getElementById('prev-page')?.addEventListener('click', () => {
          if (this.currentPage > 1) {
            this.currentPage--;
            this.handleSearch();
          }
        });

        document.getElementById('next-page')?.addEventListener('click', () => {
          if (this.currentResults?.has_more) {
            this.currentPage++;
            this.handleSearch();
          }
        });

        // Load more for mobile
        document.getElementById('load-more-btn')?.addEventListener('click', () => {
          this.loadMore();
        });
      }

      async performInitialSearch() {
        // Check URL parameters for initial search
        const urlParams = new URLSearchParams(window.location.search);
        const hasParams = Array.from(urlParams.keys()).length > 0;
        
        if (hasParams) {
          // Populate form with URL parameters
          urlParams.forEach((value, key) => {
            const element = document.querySelector(`[name="${key}"]`);
            if (element) {
              if (element.type === 'checkbox') {
                element.checked = value === 'true';
              } else {
                element.value = value;
              }
            }
          });
          
          await this.handleSearch();
        } else {
          // Load featured products by default
          await this.searchProducts({ featured: true, per_page: 24 });
        }
      }

      async handleSearch() {
        if (this.isLoading) return;

        this.showLoading();
        
        const formData = new FormData(document.getElementById('search-form'));
        const params = {};
        
        for (const [key, value] of formData.entries()) {
          if (value && value !== '') {
            params[key] = value;
          }
        }

        // Add current page and language
        params.page = this.currentPage;
        params.lang = lang;

        await this.searchProducts(params);
        
        // Update URL without page reload
        const url = new URL(window.location);
        Object.keys(params).forEach(key => {
          if (params[key]) {
            url.searchParams.set(key, params[key]);
          } else {
            url.searchParams.delete(key);
          }
        });
        window.history.pushState({}, '', url);
      }

      async searchProducts(params) {
        this.isLoading = true;
        
        try {
          const searchParams = new URLSearchParams(params);
          const response = await fetch(`/api/products/search?${searchParams}`);
          
          if (!response.ok) {
            throw new Error(`Search failed: ${response.status} ${response.statusText}`);
          }

          const results = await response.json();
          this.currentResults = results;
          this.displayResults(results);
          
          // Track search event
          this.trackEvent('product_search', {
            query: params.q || '',
            results_count: results.total,
            search_time: results.search_time_ms
          });

        } catch (error) {
          console.error('Search error:', error);
          this.showError(error.message);
          
          // Track error event
          this.trackEvent('search_error', {
            error: error.message,
            query: params.q || ''
          });
        } finally {
          this.isLoading = false;
          this.hideLoading();
        }
      }

      displayResults(results) {
        this.hideAllStates();

        if (results.total === 0) {
          this.showNoResults();
          return;
        }

        // Show results header
        const header = document.getElementById('results-header');
        const title = document.getElementById('results-title');
        const summary = document.getElementById('results-summary');
        const meta = document.getElementById('results-meta');

        title.textContent = results.total === 1 
          ? t.oneProductFound 
          : t.productsFound.replace('{count}', results.total);
          
        summary.textContent = `${t.showing} ${results.products.length} ${t.of} ${results.total} ${t.products}`;
        meta.textContent = `${t.searchTime}: ${results.search_time_ms}ms`;
        
        header.classList.remove('hidden');

        // Display active filters
        this.displayActiveFilters();

        // Display products
        this.displayProducts(results.products);

        // Display pagination
        this.displayPagination(results);
      }

      displayProducts(products) {
        const grid = document.getElementById('products-grid');
        grid.innerHTML = '';

        products.forEach(product => {
          const productCard = this.createProductCard(product);
          grid.appendChild(productCard);
        });

        grid.classList.remove('hidden');
      }

      createProductCard(product) {
        const card = document.createElement('div');
        card.className = 'bg-white rounded-lg shadow-md overflow-hidden transition-all duration-200 hover:shadow-lg hover:-translate-y-1';
        card.setAttribute('data-product-id', product.id);
        card.setAttribute('data-track-event', 'product_view');
        card.setAttribute('data-track-category', 'product_catalog');
        card.setAttribute('data-track-label', product.name);

        const imageHtml = product.image 
          ? `<img src="${product.image}" alt="${product.name}" class="w-full h-48 object-cover transition-transform duration-300 hover:scale-105" loading="lazy" width="300" height="192" decoding="async">`
          : `<div class="w-full h-48 bg-gray-200 flex items-center justify-center">
               <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
               </svg>
             </div>`;

        const priceHtml = product.on_sale 
          ? `<div class="flex items-center gap-2">
               <span class="text-xl font-bold text-red-600">$${product.sale_price}</span>
               <span class="text-sm text-gray-500 line-through">$${product.regular_price}</span>
               <span class="bg-red-100 text-red-800 text-xs px-2 py-1 rounded">${t.sale}</span>
             </div>`
          : `<span class="text-xl font-bold text-gray-900">$${product.price}</span>`;

        const ratingHtml = product.rating > 0 
          ? `<div class="flex items-center gap-1 mb-2">
               <div class="flex text-yellow-400">
                 ${'★'.repeat(Math.floor(product.rating))}${'☆'.repeat(5 - Math.floor(product.rating))}
               </div>
               <span class="text-sm text-gray-600">(${product.rating_count})</span>
             </div>`
          : '';

        card.innerHTML = `
          <div class="relative">
            ${imageHtml}
            ${product.featured ? `<span class="absolute top-2 left-2 bg-blue-600 text-white text-xs px-2 py-1 rounded">${t.featured}</span>` : ''}
            ${product.stock_status === 'outofstock' ? `<span class="absolute top-2 right-2 bg-red-600 text-white text-xs px-2 py-1 rounded">${t.outOfStock}</span>` : ''}
          </div>
          <div class="p-4">
            <h3 class="text-lg font-semibold text-gray-900 mb-2 line-clamp-2">${product.name}</h3>
            ${ratingHtml}
            <p class="text-gray-600 text-sm mb-3 line-clamp-3">${product.description || ''}</p>
            <div class="flex justify-between items-center">
              ${priceHtml}
              <a href="/${lang}/products/${product.slug}" 
                 class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors text-sm font-medium"
                 data-track-event="product_click"
                 data-track-category="product_catalog"
                 data-track-label="${product.name}"
              >
                ${t.viewDetails}
              </a>
            </div>
          </div>
        `;

        return card;
      }

      displayPagination(results) {
        if (results.total_pages <= 1) return;

        const pagination = document.getElementById('pagination');
        const prevBtn = document.getElementById('prev-page');
        const nextBtn = document.getElementById('next-page');
        const pageNumbers = document.getElementById('page-numbers');

        // Update buttons
        prevBtn.disabled = results.page <= 1;
        nextBtn.disabled = !results.has_more;

        // Generate page numbers
        pageNumbers.innerHTML = '';
        const currentPage = results.page;
        const totalPages = results.total_pages;
        
        // Show page numbers (with ellipsis for large page counts)
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
          const pageBtn = document.createElement('button');
          pageBtn.className = `px-3 py-2 text-sm rounded ${
            i === currentPage 
              ? 'bg-blue-600 text-white' 
              : 'text-gray-700 hover:bg-gray-100'
          }`;
          pageBtn.textContent = i;
          pageBtn.addEventListener('click', () => {
            this.currentPage = i;
            this.handleSearch();
          });
          pageNumbers.appendChild(pageBtn);
        }

        pagination.classList.remove('hidden');
      }

      displayActiveFilters() {
        const filtersDiv = document.getElementById('active-filters');
        const tagsDiv = document.getElementById('filter-tags');
        const formData = new FormData(document.getElementById('search-form'));
        
        tagsDiv.innerHTML = '';
        let hasFilters = false;

        for (const [key, value] of formData.entries()) {
          if (value && value !== '' && key !== 'page') {
            hasFilters = true;
            const tag = document.createElement('span');
            tag.className = 'bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm flex items-center gap-2';
            tag.innerHTML = `
              ${this.getFilterLabel(key)}: ${value}
              <button class="hover:text-blue-600" data-remove-filter="${key}">✕</button>
            `;
            
            // Add remove filter functionality
            tag.querySelector('button').addEventListener('click', () => {
              document.querySelector(`[name="${key}"]`).value = '';
              this.handleSearch();
            });
            
            tagsDiv.appendChild(tag);
          }
        }

        if (hasFilters) {
          filtersDiv.classList.remove('hidden');
        } else {
          filtersDiv.classList.add('hidden');
        }
      }

      getFilterLabel(key) {
        const labels = {
          q: t.search,
          category: t.category,
          sort: t.sortBy,
          min_price: t.minPrice,
          max_price: t.maxPrice,
          per_page: t.perPage,
          featured: t.featured
        };
        return labels[key] || key;
      }

      showLoading() {
        document.getElementById('loading-state').classList.remove('hidden');
      }

      hideLoading() {
        document.getElementById('loading-state').classList.add('hidden');
      }

      showError(message) {
        this.hideAllStates();
        const errorState = document.getElementById('error-state');
        document.getElementById('error-message').textContent = message;
        errorState.classList.remove('hidden');
      }

      showNoResults() {
        this.hideAllStates();
        document.getElementById('no-results-state').classList.remove('hidden');
      }

      hideAllStates() {
        ['loading-state', 'error-state', 'no-results-state', 'results-header', 'active-filters', 'products-grid', 'pagination', 'load-more'].forEach(id => {
          document.getElementById(id)?.classList.add('hidden');
        });
      }

      clearFilters() {
        document.getElementById('search-form').reset();
        this.currentPage = 1;
        this.handleSearch();
      }

      trackEvent(eventName, data) {
        // Google Tag Manager event tracking
        if (typeof gtag !== 'undefined') {
          gtag('event', eventName, {
            event_category: 'product_catalog',
            event_label: data.query || '',
            value: data.results_count || 0,
            custom_parameter_1: data.search_time || 0
          });
        }

        // Console log for debugging
        console.log('Track event:', eventName, data);
      }
    }

    // Initialize the catalog when DOM is loaded
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        new ProductCatalog();
      });
    } else {
      new ProductCatalog();
    }
  </script>
</Layout>
