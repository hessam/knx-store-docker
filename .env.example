# WooCommerce API Configuration
# Replace with your WooCommerce store URL and API credentials
WOOCOMMERCE_API_URL=https://your-store.com/wp-json/wc/v3
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key_here
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret_here

# WordPress Configuration (if needed)
WORDPRESS_API_URL=https://your-store.com/wp-json

# Redis Configuration (optional - for caching)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Google Services (optional - for translation)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# Site Configuration
NODE_ENV=development
SITE_URL=http://localhost:4321

# Build Configuration
# Set to true to allow builds without API credentials (uses fallback data)
ALLOW_BUILD_WITHOUT_API=true

# Instructions:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual WooCommerce API credentials
# 3. Get WooCommerce API keys from: WooCommerce > Settings > Advanced > REST API
# 4. Make sure your WooCommerce store has products published
# 5. For production, set NODE_ENV=production and update SITE_URL
